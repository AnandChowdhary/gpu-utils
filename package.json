{
  "name": "gpu-utils",
  "private": true,
  "description": "Tiny libraries for doing things in the browser with WebGPU",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "size": "pnpm -r --filter './packages/*' size",
    "check:package": "pnpm -r --filter './packages/*' check:package",
    "new": "node --experimental-strip-types tooling/new-package.ts",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.20.3",
    "@webgpu/types": "0.1.72",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1",
    "wgslender": "1.4.1"
  }
}
